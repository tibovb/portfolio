---
import { skills } from '../data/skills';
import Icon from './Icon.astro';
import { Icon as Logo } from 'astro-icon/components';
---

<section id="skills" aria-labelledby="skills-title">
  <div class="container">
    <h2 id="skills-title" class="section-title" data-reveal>Skills</h2>
    <ul class="skill-index">
      {
        skills.map((group, i) => (
          <li class="skill-row" data-reveal data-delay={String(Math.min(i, 2))} style={`--card-hue: ${group.hue}`}>
            <div class="row-head">
              <span class="row-icon" aria-hidden="true">
                <Icon name={group.icon} size={18} />
              </span>
              <h3>{group.title}</h3>
            </div>
            <div class="row-items">
              {group.items.map((item) => (
                <span class="row-item">
                  {item.logo && <Logo name={item.logo} class="row-logo" aria-hidden="true" />}
                  {item.label}
                </span>
              ))}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .skill-index {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .skill-row {
    display: grid;
    grid-template-columns: minmax(15rem, 1fr) 1.8fr;
    gap: 1rem 2.5rem;
    align-items: start;
    padding-block: 1.7rem;
    border-top: 1px solid var(--border);
    transition: background 0.25s ease;
  }
  .skill-index .skill-row:last-child {
    border-bottom: 1px solid var(--border);
  }
  .skill-row:hover {
    background: linear-gradient(
      90deg,
      hsl(var(--card-hue) 50% 40% / 0.07),
      transparent 70%
    );
  }
  .row-head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .skill-row:hover .row-head {
    transform: translateX(0.5rem);
  }
  .row-icon {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 9px;
    flex-shrink: 0;
    color: hsl(var(--card-hue) 75% var(--hue-icon-l));
    background: hsl(var(--card-hue) 70% 55% / 0.13);
    border: 1px solid hsl(var(--card-hue) 65% 60% / 0.3);
  }
  .row-head h3 {
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    font-weight: 700;
    margin: 0;
  }
  .skill-row:hover .row-head h3 {
    color: hsl(var(--card-hue) 80% var(--hue-icon-l));
  }
  .row-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.4rem;
    align-content: center;
    padding-top: 0.35rem;
  }
  .row-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .row-items :global(.row-logo) {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  @media (max-width: 720px) {
    .skill-row {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
  }
</style>
