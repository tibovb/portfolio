---
import { skills } from '../data/skills';
import Icon from './Icon.astro';
import { Icon as Logo } from 'astro-icon/components';
---

<section id="skills" aria-labelledby="skills-title">
  <div class="container">
    <h2 id="skills-title" class="section-title" data-index="02." data-reveal>Skills</h2>
    <div class="skills-grid">
      {
        skills.map((group, i) => (
          <div class="skill-card" data-reveal data-delay={String(Math.min(i, 3))} style={`--card-hue: ${group.hue}`}>
            <span class="skill-watermark" aria-hidden="true">
              <Icon name={group.icon} size={120} />
            </span>
            <div class="skill-head">
              <span class="skill-icon" aria-hidden="true">
                <Icon name={group.icon} size={19} />
              </span>
              <h3>{group.title}</h3>
            </div>
            <ul class="chips">
              {group.items.map((item) => (
                <li>
                  <span class="chip">
                    {item.logo && <Logo name={item.logo} class="chip-logo" aria-hidden="true" />}
                    {item.label}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }
  .skill-card {
    position: relative;
    overflow: hidden;
    padding: 1.5rem;
    background:
      linear-gradient(180deg, hsl(var(--card-hue) 70% 55% / 0.08), transparent 45%),
      var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .skill-card:hover {
    border-color: hsl(var(--card-hue) 65% 60% / 0.55);
    transform: translateY(-3px);
  }
  .skill-watermark {
    position: absolute;
    right: -1.6rem;
    bottom: -1.8rem;
    color: hsl(var(--card-hue) 70% 60%);
    opacity: 0.07;
    transform: rotate(-12deg);
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .skill-card:hover .skill-watermark {
    opacity: 0.13;
    transform: rotate(-6deg) scale(1.04);
  }
  .skill-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 1rem;
  }
  .skill-icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 10px;
    color: hsl(var(--card-hue) 80% 68%);
    background: hsl(var(--card-hue) 70% 55% / 0.14);
    border: 1px solid hsl(var(--card-hue) 65% 60% / 0.35);
    flex-shrink: 0;
  }
  .skill-card h3 {
    font-size: 1.05rem;
    margin: 0;
  }
  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chips .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .chips :global(.chip-logo) {
    width: 0.95rem;
    height: 0.95rem;
    flex-shrink: 0;
  }
</style>
