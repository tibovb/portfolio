---
import { projects } from '../data/projects';
import Icon from './Icon.astro';
import { Image } from 'astro:assets';

// Project screenshots live in src/assets/projects/ and are matched by filename.
const shots = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/projects/*.{png,jpg,jpeg,webp}',
  { eager: true }
);
const shotFor = (name?: string) =>
  name
    ? Object.entries(shots).find(([path]) => path.includes(`/${name}.`))?.[1]?.default
    : undefined;

// Attach the resolved screenshot + orientation to each project.
const items = projects.map((p) => {
  const shot = shotFor(p.image);
  return { ...p, shot, wide: shot ? shot.width > shot.height : false };
});
---

<section id="projects" aria-labelledby="projects-title">
  <div class="container">
    <h2 id="projects-title" class="section-title" data-reveal>Projects</h2>
  </div>

  <div class="container stack">
    {
      items.map((project, i) => (
        <article class:list={['panel', { 'panel--wide': project.wide }]} style={`--card-hue: ${project.hue ?? 24}; --i: ${i}`}>
          <div class="panel-info">
            {(project.kicker || project.featured) && (
              <p class="panel-kicker">{project.kicker ?? 'Flagship product'}</p>
            )}
            <h3 class="panel-title">
              {project.demo ? (
                <a href={project.demo} target="_blank" rel="noopener noreferrer">{project.title}</a>
              ) : (
                project.title
              )}
            </h3>
            <p class="panel-desc">{project.description}</p>
            <ul class="tags">
              {project.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <div class="panel-links">
              {project.demo && (
                <a href={project.demo} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
                  View live
                  <Icon name="external" size={16} />
                </a>
              )}
              {project.source && (
                <a href={project.source} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
                  <Icon name="github" size={16} />
                  Source
                </a>
              )}
            </div>
          </div>

          <div class="panel-visual">
            {
              project.shot ? (
                project.wide ? (
                  <div class="browser">
                    <div class="browser-bar" aria-hidden="true">
                      <span /><span /><span />
                    </div>
                    <Image
                      src={project.shot}
                      alt={`${project.title} screenshot`}
                      width={1100}
                      densities={[1, 2]}
                      loading="lazy"
                    />
                  </div>
                ) : (
                  <div class="panel-shot">
                    <Image
                      src={project.shot}
                      alt={`${project.title} app screenshot`}
                      width={440}
                      densities={[1, 2]}
                      loading="lazy"
                    />
                  </div>
                )
              ) : (
                <span class="panel-icon" aria-hidden="true">
                  <Icon name={project.icon ?? 'code'} size={56} />
                </span>
              )
            }
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  /* Panels pin under the header and stack over each other while scrolling */
  .stack {
    display: grid;
    gap: 1.5rem;
  }
  .panel {
    position: sticky;
    top: calc(5.5rem + var(--i) * 1.4rem);
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    min-height: clamp(24rem, 60vh, 33rem);
    padding: clamp(1.75rem, 4.5vw, 3.5rem);
    border-radius: 20px;
    border: 1px solid hsl(var(--card-hue) 45% 40% / 0.35);
    /* Opaque so it fully covers the previous panel while stacking */
    background:
      radial-gradient(
        30rem 18rem at 85% 0%,
        hsl(var(--card-hue) 55% 30% / 0.25),
        transparent 65%
      ),
      color-mix(in srgb, hsl(var(--card-hue) 40% 14%) 45%, var(--bg-elevated));
    box-shadow: 0 -12px 40px rgba(0, 0, 0, 0.4);
    overflow: hidden;
  }
  .panel-kicker {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: hsl(var(--card-hue) 80% var(--hue-icon-l));
    margin: 0 0 0.9rem;
  }
  .panel-title {
    font-size: clamp(1.8rem, 4.5vw, 3rem);
    font-weight: 800;
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
  }
  .panel-title a {
    color: var(--text);
  }
  .panel-title a:hover {
    color: hsl(var(--card-hue) 80% var(--hue-icon-l));
  }
  .panel-desc {
    color: var(--text-muted);
    font-size: 1.02rem;
    max-width: 52ch;
    margin: 0 0 1.4rem;
  }
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: 0 0 1.6rem;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .panel-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .panel-visual {
    display: grid;
    place-items: center;
    position: relative;
    min-height: 12rem;
  }

  /* Wide panels (landscape screenshots): give the visual a bit more room,
     kept beside the text so it stays fully visible in the pinned band. */
  .panel--wide {
    grid-template-columns: 0.95fr 1.15fr;
  }

  /* Phone screenshot: tall, floats slightly rotated, straightens on hover */
  .panel-shot {
    border-radius: clamp(1.4rem, 2.4vw, 2rem);
    overflow: hidden;
    box-shadow:
      0 30px 60px rgba(0, 0, 0, 0.5),
      0 0 50px hsl(var(--card-hue) 70% 50% / 0.22);
    transform: rotate(-3.5deg);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .panel:hover .panel-shot {
    transform: rotate(0deg) scale(1.02);
  }
  .panel-shot :global(img) {
    display: block;
    width: auto;
    height: min(52vh, 27rem);
    max-width: 100%;
  }

  /* Web screenshot: framed like a browser window */
  .browser {
    width: 100%;
    max-width: 60rem;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid hsl(var(--card-hue) 40% 45% / 0.35);
    box-shadow:
      0 30px 60px rgba(0, 0, 0, 0.5),
      0 0 60px hsl(var(--card-hue) 70% 50% / 0.18);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .panel:hover .browser {
    transform: translateY(-4px);
  }
  .browser-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 0.9rem;
    background: #14110e;
    border-bottom: 1px solid hsl(var(--card-hue) 30% 30% / 0.4);
  }
  .browser-bar span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: hsl(var(--card-hue) 25% 40%);
  }
  .browser :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .panel-icon {
    display: grid;
    place-items: center;
    width: clamp(7rem, 14vw, 10rem);
    height: clamp(7rem, 14vw, 10rem);
    border-radius: 28px;
    color: hsl(var(--card-hue) 80% var(--hue-icon-l));
    background: hsl(var(--card-hue) 65% 50% / 0.14);
    border: 1px solid hsl(var(--card-hue) 60% 55% / 0.35);
    box-shadow: 0 0 60px hsl(var(--card-hue) 70% 50% / 0.25);
    transform: rotate(-4deg);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .panel:hover .panel-icon {
    transform: rotate(0deg) scale(1.05);
  }

  @media (max-width: 820px) {
    .panel {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .panel-visual {
      min-height: 0;
    }
    /* Icon fallback adds nothing on mobile, but a real screenshot stays */
    .panel-icon {
      display: none;
    }
    .panel-shot {
      max-height: 22rem;
    }
  }
</style>
