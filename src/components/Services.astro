---
import { services } from '../data/services';
import Icon from './Icon.astro';
---

<section id="services" aria-labelledby="services-title">
  <div class="container">
    <h2 id="services-title" class="section-title" data-reveal>How I can help</h2>

    <div class="services-grid">
      {
        services.map((s, i) => (
          <article class="service" data-reveal data-delay={String(Math.min(i, 3))} style={`--card-hue: ${s.hue}`}>
            <span class="service-icon" aria-hidden="true">
              <Icon name={s.icon} size={24} />
            </span>
            <h3>{s.title}</h3>
            <p>{s.description}</p>
          </article>
        ))
      }
    </div>

    <div class="services-cta" data-reveal>
      <p>Building something for your sport, team, or business?</p>
      <a href="#contact" class="btn btn-primary">Let’s talk<Icon name="arrow" size={18} /></a>
    </div>
  </div>
</section>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.25rem;
  }
  .service {
    position: relative;
    padding: 1.75rem;
    border-radius: var(--radius);
    background:
      linear-gradient(180deg, hsl(var(--card-hue) 60% 45% / 0.08), transparent 45%),
      var(--bg-elevated);
    border: 1px solid var(--border);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .service:hover {
    transform: translateY(-4px);
    border-color: hsl(var(--card-hue) 55% 55% / 0.5);
    box-shadow: var(--shadow), var(--glow);
  }
  .service-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 13px;
    margin-bottom: 1.15rem;
    color: hsl(var(--card-hue) 75% var(--hue-icon-l));
    background: hsl(var(--card-hue) 65% 50% / 0.14);
    border: 1px solid hsl(var(--card-hue) 60% 55% / 0.35);
  }
  .service h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 0.6rem;
  }
  .service p {
    color: var(--text-muted);
    font-size: 0.98rem;
    margin: 0;
  }

  .services-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 2.5rem;
    padding: 1.6rem 1.9rem;
    border-radius: var(--radius);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--border));
    background: linear-gradient(120deg, color-mix(in srgb, var(--accent) 9%, transparent), transparent 60%);
  }
  .services-cta p {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.6vw, 1.5rem);
    font-weight: 600;
    color: var(--text);
  }
</style>
