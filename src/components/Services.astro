---
import { services } from '../data/services';
import Icon from './Icon.astro';
---

<section id="services" aria-labelledby="services-title">
  <div class="container">
    <h2 id="services-title" class="section-title" data-reveal>How I can help</h2>
    <p class="services-lead" data-reveal>
      You work directly with the person who builds it. No agencies, no hand-offs,
      no account managers in between. Just software that ships.
    </p>

    <div class="services-grid">
      {
        services.map((s, i) => (
          <article class="service" data-reveal data-delay={String(Math.min(i, 3))} style={`--card-hue: ${s.hue}`}>
            <span class="service-watermark" aria-hidden="true">
              <Icon name={s.icon} size={128} />
            </span>
            <span class="service-icon" aria-hidden="true">
              <Icon name={s.icon} size={24} />
            </span>
            <p class="service-label">{s.label}</p>
            <h3>{s.title}</h3>
            <p class="service-desc">{s.description}</p>
          </article>
        ))
      }
    </div>

    <div class="services-cta" data-reveal>
      <p>Got something you want built properly? Let’s talk it over.</p>
      <a href="#contact" class="btn btn-primary">Let’s talk<Icon name="arrow" size={18} /></a>
    </div>
  </div>
</section>

<style>
  .services-lead {
    max-width: 52ch;
    margin: -1.4rem 0 2.5rem;
    font-size: 1.1rem;
    color: var(--text-muted);
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.25rem;
  }
  .service {
    position: relative;
    overflow: hidden;
    padding: 1.9rem;
    border-radius: var(--radius);
    background:
      linear-gradient(180deg, hsl(var(--card-hue) 60% 45% / 0.09), transparent 45%),
      var(--bg-elevated);
    border: 1px solid var(--border);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .service:hover {
    transform: translateY(-5px);
    border-color: hsl(var(--card-hue) 55% 55% / 0.55);
    box-shadow: var(--shadow), var(--glow);
  }
  /* Big faded icon in the corner, brightens on hover */
  .service-watermark {
    position: absolute;
    right: -1.6rem;
    bottom: -1.9rem;
    color: hsl(var(--card-hue) 70% 60%);
    opacity: 0.08;
    transform: rotate(-10deg);
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .service:hover .service-watermark {
    opacity: 0.16;
    transform: rotate(-4deg) scale(1.05);
  }
  .service-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 13px;
    margin-bottom: 1.2rem;
    color: hsl(var(--card-hue) 75% var(--hue-icon-l));
    background: hsl(var(--card-hue) 65% 50% / 0.15);
    border: 1px solid hsl(var(--card-hue) 60% 55% / 0.35);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .service:hover .service-icon {
    transform: rotate(-6deg) scale(1.08);
  }
  .service-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--card-hue) 75% var(--hue-icon-l));
    margin: 0 0 0.5rem;
  }
  .service h3 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0 0 0.7rem;
  }
  .service-desc {
    color: var(--text-muted);
    font-size: 0.98rem;
    margin: 0;
    position: relative;
  }

  .services-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 2.5rem;
    padding: 1.7rem 2rem;
    border-radius: var(--radius);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--border));
    background: linear-gradient(120deg, color-mix(in srgb, var(--accent) 10%, transparent), transparent 60%);
  }
  .services-cta p {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.6vw, 1.55rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
  }
</style>
