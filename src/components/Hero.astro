---
import { site } from '../data/site';
import Icon from './Icon.astro';

const [firstName, ...rest] = site.name.split(' ');
const lastName = rest.join(' ');
const year = new Date().getFullYear();
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true"></div>

  <div class="container hero-stage">
    <div class="hero-top" data-reveal>
      <p class="status">
        <span class="status-mug" aria-hidden="true">
          <Icon name="coffee" size={17} />
        </span>
        Available for freelance
      </p>
      <p class="hero-meta">{site.location} · {year}</p>
    </div>

    <h1 id="hero-title">
      <span class="line" data-reveal data-delay="1">{firstName}</span>
      <span class="line line-last" data-reveal data-delay="2">{lastName}</span>
    </h1>

    <div class="hero-foot">
      <p class="role" data-reveal data-delay="2">{site.role}</p>
      <p class="tagline" data-reveal data-delay="3">{site.tagline}</p>
    </div>

    <div class="hero-cta" data-reveal data-delay="3">
      <a href="#projects" class="btn btn-primary">
        View my work
        <Icon name="arrow" size={18} />
      </a>
      <a href="#contact" class="btn btn-ghost">Get in touch</a>
      <div class="socials">
        {
          site.socials.map((s) => (
            <a href={s.href} class="social" aria-label={s.label} target={s.href.startsWith('http') ? '_blank' : undefined} rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
              <Icon name={s.icon} />
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <a class="scroll-cue" href="#about" aria-label="Scroll down">
    <span class="cue-line" aria-hidden="true"></span>
  </a>
</section>

<script is:inline>
  // Subtle cursor spotlight + gentle parallax on the big name.
  (() => {
    const fine = window.matchMedia('(pointer: fine)').matches;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const hero = document.querySelector('.hero');
    const title = document.getElementById('hero-title');
    if (!hero || reduce) return;

    if (fine) {
      let raf = null;
      let ev = null;
      const update = () => {
        raf = null;
        const r = hero.getBoundingClientRect();
        hero.style.setProperty('--sx', ev.clientX - r.left + 'px');
        hero.style.setProperty('--sy', ev.clientY - r.top + 'px');
      };
      hero.addEventListener(
        'mousemove',
        (e) => {
          ev = e;
          if (!raf) raf = requestAnimationFrame(update);
        },
        { passive: true }
      );
    }

    if (title) {
      let raf2 = null;
      const onScroll = () => {
        raf2 = null;
        const y = window.scrollY;
        if (y < window.innerHeight) {
          title.style.transform = `translateY(${y * 0.18}px)`;
          title.style.opacity = String(Math.max(0, 1 - y / (window.innerHeight * 0.9)));
        }
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!raf2) raf2 = requestAnimationFrame(onScroll);
        },
        { passive: true }
      );
    }
  })();
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: 6rem 4rem;
  }
  .hero-stage {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3.5vh, 3rem);
  }

  /* Top row: availability + place, like poster margins */
  .hero-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
  }
  .status-mug {
    display: inline-grid;
    place-items: center;
    color: var(--accent);
  }
  /* Steam rises gently from the mug */
  .status-mug :global(.steam) {
    animation: steam 2.6s ease-in-out infinite;
  }
  .status-mug :global(.steam:nth-of-type(2)) {
    animation-delay: 0.45s;
  }
  .status-mug :global(.steam:nth-of-type(3)) {
    animation-delay: 0.9s;
  }
  @keyframes steam {
    0%,
    100% {
      opacity: 0.25;
      transform: translateY(0.5px);
    }
    50% {
      opacity: 1;
      transform: translateY(-1px);
    }
  }
  .hero-meta {
    margin: 0;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
  }

  /* The poster name */
  h1 {
    margin: 0;
    text-transform: uppercase;
    font-weight: 800;
    font-size: clamp(2.8rem, 10.5vw, 8.25rem);
    line-height: 0.94;
    letter-spacing: -0.035em;
    will-change: transform, opacity;
  }
  .line {
    display: block;
    white-space: nowrap;
  }
  .line-last {
    text-align: right;
    color: transparent;
    -webkit-text-stroke: 2px color-mix(in srgb, var(--text) 80%, transparent);
  }
  @supports not (-webkit-text-stroke: 1px black) {
    .line-last {
      color: var(--text);
    }
  }

  /* Bottom composition: role + tagline opposing corners */
  .hero-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }
  .role {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.4vw, 1.6rem);
    font-weight: 600;
    color: var(--accent);
    margin: 0;
    max-width: 22ch;
  }
  .tagline {
    max-width: 44ch;
    font-size: 1rem;
    color: var(--text-muted);
    margin: 0;
    text-align: right;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
  }
  .socials {
    display: flex;
    gap: 0.5rem;
    margin-left: auto;
  }
  .social {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    border: 1px solid var(--border);
    transition: color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }
  .social:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  /* Scroll cue: a thin falling line */
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.4rem;
    transform: translateX(-50%);
    padding: 0.5rem;
  }
  .cue-line {
    display: block;
    width: 1px;
    height: 3rem;
    overflow: hidden;
    background: color-mix(in srgb, var(--text) 18%, transparent);
    position: relative;
  }
  .cue-line::after {
    content: '';
    position: absolute;
    left: 0;
    top: -50%;
    width: 100%;
    height: 50%;
    background: var(--accent);
    animation: cue 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  @keyframes cue {
    to {
      top: 100%;
    }
  }

  /* Background: quiet warm glow + cursor spotlight */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .hero-bg::before {
    content: '';
    position: absolute;
    width: 46rem;
    height: 32rem;
    left: -14rem;
    top: -12rem;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.32;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--accent) 30%, transparent),
      transparent 65%
    );
    animation: drift-a 24s ease-in-out infinite alternate;
  }
  @keyframes drift-a {
    to {
      transform: translate(7rem, 4rem) scale(1.1);
    }
  }
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      34rem circle at var(--sx, 30%) var(--sy, 30%),
      color-mix(in srgb, var(--accent) 9%, transparent),
      transparent 70%
    );
  }

  @media (max-width: 720px) {
    .line-last {
      text-align: left;
    }
    .hero-foot {
      flex-direction: column;
      align-items: flex-start;
    }
    .tagline {
      text-align: left;
    }
    .hero-meta {
      display: none;
    }
    .socials {
      margin-left: 0;
    }
  }
</style>
